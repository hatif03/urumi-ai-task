{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "Urumi gateway",
  "uid": "urumi-gateway",
  "panels": [
    { "type": "timeseries", "title": "Call rate", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum(rate(tool_calls_total[1m]))", "refId": "A" }] },
    { "type": "timeseries", "title": "Error ratio", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "sum(rate(tool_calls_total{outcome!=\"success\"}[5m])) / sum(rate(tool_calls_total[5m]))", "refId": "A" }] },
    { "type": "timeseries", "title": "p95 latency", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, server) (rate(tool_call_duration_seconds_bucket[5m])))", "refId": "A" }] },
    { "type": "timeseries", "title": "Upstream up", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "targets": [{ "expr": "upstream_up", "refId": "A" }] },
    { "type": "timeseries", "title": "Rate limit rejects", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }, "targets": [{ "expr": "sum(rate(rate_limit_rejected_total[5m]))", "refId": "A" }] }
  ],
  "time": { "from": "now-1h", "to": "now" }
}
